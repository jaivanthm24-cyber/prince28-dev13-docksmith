# Copy this file to .env and fill in real values. .env is never committed.
APP_NAME=docksmith
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/sample_records.json
# Standard local docker-compose PostgreSQL connection string:
DATABASE_URL=postgresql://app:app@localhost:5432/app # pragma: allowlist secret
TEST_DATABASE_URL=postgresql://app:app@localhost:5432/app_test # pragma: allowlist secret
REDIS_URL=redis://localhost:6379
ADMIN_TOKEN=

# LLM keys (Day 8). Free keys: https://aistudio.google.com/apikey and https://console.groq.com/keys
# Real values go in .env, GitHub Secrets and Render only. Never in Git.
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
